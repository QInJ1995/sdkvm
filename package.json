{
  "name": "sdkvm",
  "version": "1.0.7",
  "description": "SDK version manager — Java (Temurin / Zulu / Corretto), Go, Flutter, Node.js, Maven, Miniconda & Python",
  "type": "module",
  "bin": {
    "sdkvm": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run typecheck && npm run build",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "sdk",
    "jdk",
    "java",
    "go",
    "golang",
    "goroot",
    "flutter",
    "dart",
    "node",
    "nodejs",
    "maven",
    "miniconda",
    "conda",
    "python",
    "cpython",
    "version-manager",
    "temurin",
    "zulu",
    "corretto"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QInJ1995/sdkvm.git"
  },
  "bugs": {
    "url": "https://github.com/QInJ1995/sdkvm/issues"
  },
  "homepage": "https://github.com/QInJ1995/sdkvm#readme",
  "dependencies": {
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "undici": "^6.29.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  }
}
